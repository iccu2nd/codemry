# GitHub token dengan scope "repo" + "gist" -- dipakai sebagai "database"
# (repo private codery-db) dan penyimpanan kode (Gist) + aset publik (repo
# publik codery-assets). WAJIB diisi.
GITHUB_TOKEN=

# Cukup NAMA repo (bukan owner/repo) -- owner otomatis dideteksi dari akun
# pemilik token. Boleh dikosongin, defaultnya persis nama di bawah ini.
GITHUB_DB_REPO_NAME=codery-db
GITHUB_ASSETS_REPO_NAME=codery-assets

# Opsional. Kalau dikosongin, server otomatis generate sekali lalu simpan
# permanen di codery-db (session-secret.json) -- jadi sesi login gak
# ke-reset walau proses restart / redeploy. Isi manual di sini kalau mau
# full kontrol sendiri.
SESSION_SECRET=

# Domain yang boleh manggil API ini lewat CORS (dipisah koma kalau lebih
# dari satu). Isi domain final kamu, misal:
# https://codery.vercel.app,https://codery-git-main-username.vercel.app
ALLOWED_ORIGINS=

# Opsional, buat fitur stiker GIF di kolom komentar.
TENOR_API_KEY=

# Opsional tapi disarankan kalau deploy ke Vercel: Vercel otomatis nyisipin
# header "Authorization: Bearer <CRON_SECRET>" tiap manggil endpoint cron
# pruning, jadi endpoint-nya gak bisa dipicu sembarang orang dari luar.
CRON_SECRET=

# Cuma relevan buat jalan lokal / VPS (node server.js langsung). Di Vercel
# ini diabaikan -- port di-atur otomatis sama platform.
PORT=3000
